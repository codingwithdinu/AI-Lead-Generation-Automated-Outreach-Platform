# Backend environment (server-side secrets — never commit the real .env)

# Resend API key (sends emails)
RESEND_API_KEY=your-resend-api-key

# Twilio credentials (AI voice calls)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Server port
PORT=5000

# Optional sender address for Resend
EMAIL_FROM=TradeConnect AI <onboarding@resend.dev>